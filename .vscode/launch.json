{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WSL Debug mdriver",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/mdriver",
      "args": ["-V", "-f", "traces/random-bal.rep"],  // 또는 ["-f", "traces/amptjp.rep"]
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",  // WSL 내 gdb 경로
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}